# Application Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_PATH=./social_studio.db

# Real Free Target Configuration (Discord Webhook or Telegram Bot)
# Optional: Provide a real Discord Webhook URL for live delivery.
# If omitted, safe local mock delivery with live preview URLs is used automatically.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/placeholder_id/placeholder_token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=@my_channel_placeholder

# Default Active Publisher Adapter (mock_x | mock_linkedin | discord | telegram)
DEFAULT_PUBLISHER_ADAPTER=discord
